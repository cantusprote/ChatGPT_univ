ZOTERO_DB=~/Zotero/zotero.sqlite
ZOTERO_STORAGE=~/Zotero/storage
ZOTERO_LINKED_ATTACHMENT_BASE_DIR=
MCP_HOST=0.0.0.0
MCP_PORT=9000
MCP_PATH=/mcp

# Obsidian keeps its own independent ChromaDB under this project directory.
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/Obsidian/Vault
OBSIDIAN_DATA_PATH=.obsidian-mcp
OBSIDIAN_EMBEDDING_MODEL=intfloat/multilingual-e5-small
OBSIDIAN_COLLECTION=obsidian_notes_v1
OBSIDIAN_OCR_LANGUAGES=eng+kor
OBSIDIAN_OCR_MAX_BYTES=26214400
OBSIDIAN_AUTO_INDEX=true
